<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.brand_olive }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
  {%- else -%}
    <link rel="icon" type="image/png" href="{{ 'tinybeans-favicon-64.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'tinybeans-favicon-512.png' | asset_url }}">
  {%- endif -%}
  <title>{{ page_title | escape }}{% if current_tags %} – {{ current_tags | join: ', ' | escape }}{% endif %}{% if current_page != 1 %} – {{ current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name | escape }}{% endunless %}</title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}
  {% render 'meta-tags' %}
  <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  {% render 'font-faces' %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>:root{--olive:{{ settings.brand_olive }};--cream:{{ settings.brand_cream }}}</style>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body class="template-{{ request.page_type | handle }}">
  <a class="skip-link" href="#MainContent">{{ 'general.skip_to_content' | t }}</a>
  {% sections 'header-group' %}
  <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
</body>
</html>
