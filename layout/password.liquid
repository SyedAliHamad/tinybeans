<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="{{ settings.brand_olive }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
  {%- else -%}
    <link rel="icon" type="image/svg+xml" href="{{ 'tinybeans-favicon.svg' | asset_url }}">
    <link rel="icon" type="image/png" sizes="64x64" href="{{ 'tinybeans-favicon-64.png' | asset_url }}">
  {%- endif -%}
  <title>{{ shop.name | escape }}</title>
  {%- if page_description -%}<meta name="description" content="{{ page_description | escape }}">{%- endif -%}
  {% render 'meta-tags' %}
  <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  {% render 'font-faces' %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>:root{--olive:{{ settings.brand_olive }};--cream:{{ settings.brand_cream }}}</style>
  {{ content_for_header }}
</head>
<body class="template-password">
  <main id="MainContent">{{ content_for_layout }}</main>
</body>
</html>
