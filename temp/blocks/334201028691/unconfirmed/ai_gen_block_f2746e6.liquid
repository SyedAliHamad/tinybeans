{% doc %}
  @prompt
    Create a floating product-video player for product pages. Show a small bottom-left video bubble that stays visible while scrolling, with muted playback, tap-to-expand, accessible play/pause and mute controls, and a close button. Make it responsive and position it so it does not cover buying buttons or other essential controls on mobile. Support a different video for each product using a product file-reference video metafield named Floating video (custom.floating_video), with a compatible video picker/dynamic source setting where supported. Hide the entire player if the current product has no video assigned; never reuse another product's video. Keep video size, corner position, and spacing merchant-editable. Match the existing theme styling. Respect reduced motion preferences and allow user-initiated playback when autoplay is blocked.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign floating_video = product.metafields.custom.floating_video.value %}

{% if product != blank and floating_video != blank %}
  {% style %}
    .ai-floating-video-{{ ai_gen_id }} {
      display: block;
      position: fixed;
      z-index: 40;
      width: {{ block.settings.video_size }}px;
      max-width: calc(100vw - 32px);
      {% if block.settings.corner == 'bottom_left' %}
        left: {{ block.settings.edge_spacing }}px;
        right: auto;
      {% else %}
        right: {{ block.settings.edge_spacing }}px;
        left: auto;
      {% endif %}
      bottom: calc({{ block.settings.edge_spacing }}px + env(safe-area-inset-bottom, 0px));
      border-radius: 14px;
      overflow: hidden;
      background: {{ block.settings.background_color }};
      color: {{ block.settings.text_color }};
      box-shadow: 0 4px 20px rgba(0, 0, 0, .2);
      font-family: inherit;
    }

    .ai-floating-video-{{ ai_gen_id }}[hidden] { display: none; }
    .ai-floating-video-{{ ai_gen_id }}__media { position: relative; width: 100%; aspect-ratio: 9 / 16; overflow: hidden; }
    .ai-floating-video-{{ ai_gen_id }}__video { display: block; width: 100%; height: 100%; object-fit: cover; background: #202020; }
    .ai-floating-video-{{ ai_gen_id }}__controls { position: absolute; inset: 0; display: flex; align-items: flex-end; justify-content: space-between; padding: 8px; background: linear-gradient(transparent 50%, rgba(0,0,0,.55)); }
    .ai-floating-video-{{ ai_gen_id }}__control-group { display: flex; gap: 6px; }
    .ai-floating-video-{{ ai_gen_id }}__button { display: inline-flex; align-items: center; justify-content: center; min-width: 38px; min-height: 38px; padding: 7px; border: 1px solid rgba(255,255,255,.7); border-radius: 999px; background: #252820; color: #fff; font: inherit; font-size: 12px; cursor: pointer; }
    .ai-floating-video-{{ ai_gen_id }}__button:hover { background: {{ block.settings.accent_color }}; }
    .ai-floating-video-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
    .ai-floating-video-{{ ai_gen_id }}__close { position: absolute; top: 7px; right: 7px; z-index: 1; }
    .ai-floating-video-{{ ai_gen_id }}__expand { position: absolute; inset: 0; z-index: 0; border: 0; background: transparent; cursor: pointer; }
    .ai-floating-video-{{ ai_gen_id }}__expand:focus-visible { outline: 3px solid #fff; outline-offset: -4px; }
    .ai-floating-video-{{ ai_gen_id }}__controls { z-index: 1; pointer-events: none; }
    .ai-floating-video-{{ ai_gen_id }}__controls button { pointer-events: auto; }
    .ai-floating-video-{{ ai_gen_id }}.is-expanded { width: min({{ block.settings.video_size | times: 2 }}px, calc(100vw - 32px)); }
    .ai-floating-video-{{ ai_gen_id }}.is-expanded .ai-floating-video-{{ ai_gen_id }}__media { aspect-ratio: 9 / 16; }
    .ai-floating-video-{{ ai_gen_id }}__mobile-spacer { display: none; }
    @media screen and (max-width: 749px) {
      .ai-floating-video-{{ ai_gen_id }} { width: min({{ block.settings.video_size }}px, 30vw); bottom: calc({{ block.settings.edge_spacing | plus: 76 }}px + env(safe-area-inset-bottom, 0px)); }
      .ai-floating-video-{{ ai_gen_id }}.is-expanded { width: min(220px, calc(100vw - 32px)); }
      .ai-floating-video-{{ ai_gen_id }}__mobile-spacer { display: block; height: 68px; pointer-events: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .ai-floating-video-{{ ai_gen_id }} *, .ai-floating-video-{{ ai_gen_id }} *::before, .ai-floating-video-{{ ai_gen_id }} *::after { scroll-behavior: auto !important; transition: none !important; }
    }
  {% endstyle %}

  <floating-product-video-{{ ai_gen_id }} class="ai-floating-video-{{ ai_gen_id }}" {{ block.shopify_attributes }} data-product-id="{{ product.id }}" aria-label="Product video">
    <div class="ai-floating-video-{{ ai_gen_id }}__media">
      {{ floating_video | video_tag: class: 'ai-floating-video-' | append: ai_gen_id | append: '__video', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
      <button class="ai-floating-video-{{ ai_gen_id }}__expand" type="button" aria-label="Expand product video"></button>
      <button class="ai-floating-video-{{ ai_gen_id }}__button ai-floating-video-{{ ai_gen_id }}__close" type="button" aria-label="Close product video">×</button>
      <div class="ai-floating-video-{{ ai_gen_id }}__controls">
        <div class="ai-floating-video-{{ ai_gen_id }}__control-group">
          <button class="ai-floating-video-{{ ai_gen_id }}__button" type="button" data-play aria-label="Play video">Play</button>
          <button class="ai-floating-video-{{ ai_gen_id }}__button" type="button" data-mute aria-label="Unmute video">Unmute</button>
        </div>
      </div>
    </div>
    <div class="ai-floating-video-{{ ai_gen_id }}__mobile-spacer" aria-hidden="true"></div>
  </floating-product-video-{{ ai_gen_id }}>

  <script>
    (function() {
      const tagName = 'floating-product-video-{{ ai_gen_id }}';
      if (customElements.get(tagName)) return;
      class FloatingProductVideo extends HTMLElement {
        connectedCallback() {
          this.video = this.querySelector('video');
          this.playButton = this.querySelector('[data-play]');
          this.muteButton = this.querySelector('[data-mute]');
          this.expandButton = this.querySelector('.ai-floating-video-{{ ai_gen_id }}__expand');
          this.closeButton = this.querySelector('.ai-floating-video-{{ ai_gen_id }}__close');
          if (!this.video) { this.hidden = true; return; }
          this.video.muted = true;
          this.video.playsInline = true;
          if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) this.video.play().catch(function() {});
          this.syncPlayState();
          this.playButton.addEventListener('click', () => {
            if (this.video.paused) this.video.play().then(() => this.syncPlayState()).catch(() => this.syncPlayState());
            else { this.video.pause(); this.syncPlayState(); }
          });
          this.video.addEventListener('play', () => this.syncPlayState());
          this.video.addEventListener('pause', () => this.syncPlayState());
          this.muteButton.addEventListener('click', () => {
            this.video.muted = !this.video.muted;
            this.syncMuteState();
          });
          this.expandButton.addEventListener('click', () => {
            this.classList.toggle('is-expanded');
            this.expandButton.setAttribute('aria-label', this.classList.contains('is-expanded') ? 'Collapse product video' : 'Expand product video');
          });
          this.closeButton.addEventListener('click', () => {
            this.video.pause();
            this.hidden = true;
          });
          this.syncMuteState();
        }
        syncPlayState() {
          const playing = this.video && !this.video.paused;
          this.playButton.textContent = playing ? 'Pause' : 'Play';
          this.playButton.setAttribute('aria-label', playing ? 'Pause video' : 'Play video');
        }
        syncMuteState() {
          this.muteButton.textContent = this.video.muted ? 'Unmute' : 'Mute';
          this.muteButton.setAttribute('aria-label', this.video.muted ? 'Unmute video' : 'Mute video');
        }
      }
      customElements.define(tagName, FloatingProductVideo);
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Floating product video",
  "settings": [
    { "type": "header", "content": "Video source" },
    { "type": "video", "id": "video_source", "label": "Video override (optional)" },
    { "type": "paragraph", "content": "The product metafield custom.floating_video is used per product. This block hides itself if the current product has no metafield video; it will not use the optional block video override." },
    { "type": "header", "content": "Position and size" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "video_size", "label": "Bubble width", "min": 100, "max": 220, "step": 10, "unit": "px", "default": 150 },
    { "type": "select", "id": "corner", "label": "Corner", "options": [{ "value": "bottom_left", "label": "Bottom left" }, { "value": "bottom_right", "label": "Bottom right" }], "default": "bottom_left" },
    { "type": "range", "id": "edge_spacing", "label": "Edge spacing", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#252820" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#FFFFFF" },
    { "type": "color", "id": "accent_color", "label": "Button hover", "default": "#6C6E53" }
  ],
  "presets": [{ "name": "Floating product video" }],
  "tag": null,
  "class": "floating-product-video-block"
}
{% endschema %}