{%- capture credit_body -%}{% render 'welcome-credit', context: 'promo' %}{%- endcapture -%}
{%- if credit_body != blank or request.design_mode -%}
  <section class="section container tb-credit-banner">
    <div class="tb-credit-banner-inner">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow olive">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.copy != blank -%}<p class="tb-credit-copy">{{ section.settings.copy | escape }}</p>{%- endif -%}
      </div>
      <div class="tb-credit-action">
        {{ credit_body }}
        {%- if credit_body == blank and request.design_mode -%}
          <p class="tb-editor-hint">{{ 'welcome_credit.editor_hint' | t }}</p>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Welcome credit",
  "tag": "div",
  "class": "tb-credit-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the store credit offer to logged-out visitors and the real balance to signed-in customers. The amount and tag are set in Theme settings › Welcome credit. Hidden entirely when the offer is turned off or customer accounts are disabled."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A little something to start with" },
    { "type": "text", "id": "copy", "label": "Description", "default": "Create an account and your credit is ready to spend at checkout." }
  ],
  "presets": [{ "name": "Welcome credit" }]
}
{% endschema %}
