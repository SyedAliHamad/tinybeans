<section class="section centered-story container">
  {%- if section.settings.eyebrow != blank -%}<p class="section-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
  <h2>{{ section.settings.heading | escape }}</h2>
  <p>{{ section.settings.copy | escape }}</p>
  {%- if section.settings.link_label != blank -%}<a class="text-link" href="{{ section.settings.link | default: routes.root_url }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "info": "Leave blank to hide." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good baby clothes shouldn’t cost a fortune." },
    { "type": "textarea", "id": "copy", "label": "Text", "default": "Somewhere along the way, newborn essentials became unnecessarily expensive. We started Tiny Beans with a simple belief: quality, comfort and beautiful design should be within reach for more families." },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Read our story" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Brand story" }]
}
{% endschema %}
