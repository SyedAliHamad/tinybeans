<section class="fabric-detail">
  <div class="fabric-photo">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '700, 1000, 1400', sizes: '(max-width: 650px) 100vw, 50vw', alt: section.settings.image.alt }}
    {%- else -%}
      <span>{{ 'products.photo_placeholder' | t }}</span>
    {%- endif -%}
  </div>
  <div class="fabric-copy">
    {%- if section.settings.eyebrow != blank -%}<p class="section-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h2>{{ section.settings.heading | escape }}</h2>
    <p>{{ section.settings.copy | escape }}</p>
    {%- if section.settings.link_label != blank -%}<a class="text-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }}</a>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "A real close-up of fabric, lining or stitching works best." },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "info": "Leave blank to hide." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made to be soft on new skin" },
    { "type": "textarea", "id": "copy", "label": "Text", "default": "Look closer at the textures, linings and little finishes that make each piece special." },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "presets": [{ "name": "Image with text" }]
}
{% endschema %}
