<section class="tb-password">
  {%- if section.settings.image != blank -%}
    <div class="tb-password-media">{{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '700, 1100, 1500, 1800', sizes: '(max-width: 800px) 100vw, 50vw', alt: section.settings.image.alt }}</div>
  {%- endif -%}
  <div class="tb-password-content">
    <p class="tb-password-mark">{{ shop.name | escape }}</p>
    {%- assign fallback_heading = 'password.opening_soon' | t -%}
    <h1>{{ section.settings.heading | default: fallback_heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="tb-password-message">{{ shop.password_message | escape }}</p>{%- endif -%}

    {%- form 'customer', class: 'tb-password-signup' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      <p>{{ 'password.signup_text' | t }}</p>
      {%- if form.posted_successfully? -%}
        <p class="tb-form-success" role="status">{{ 'password.thanks' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}<div class="tb-form-errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="tb-inline-form">
          <label for="PasswordNewsletter" class="visually-hidden">{{ 'password.email_label' | t }}</label>
          <input id="PasswordNewsletter" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'password.email_placeholder' | t }}" required>
          <button type="submit" class="button">{{ 'password.notify' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    {%- assign wa_greeting = 'general.contact.whatsapp_greeting' | t -%}
    {%- capture wa_url -%}{% render 'whatsapp-url', message: wa_greeting %}{%- endcapture -%}
    {%- if settings.instagram_url != blank or wa_url != blank -%}
      <div class="tb-password-social">
        {%- if settings.instagram_url != blank -%}<a href="{{ settings.instagram_url }}" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}{{ 'general.contact.instagram' | t }}</a>{%- endif -%}
        {%- if wa_url != blank -%}<a href="{{ wa_url }}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp' %}{{ 'general.contact.whatsapp' | t }}</a>{%- endif -%}
      </div>
    {%- endif -%}

    {%- form 'storefront_password', class: 'tb-owner-form' -%}
      <details class="tb-owner-login"{% if form.errors %} open{% endif %}>
        <summary>{{ 'password.owner_title' | t }}</summary>
        {%- if form.errors -%}<div class="tb-form-errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="tb-inline-form">
          <label for="StorePassword" class="visually-hidden">{{ 'password.password_label' | t }}</label>
          <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password_label' | t }}">
          <button type="submit" class="button">{{ 'password.enter' | t }}</button>
        </div>
      </details>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "image_picker", "id": "image", "label": "Image" }
  ]
}
{% endschema %}
