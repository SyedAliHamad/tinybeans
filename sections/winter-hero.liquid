{%- liquid
  assign has_video = false
  if section.settings.video != blank or section.settings.video_mobile != blank
    assign has_video = true
  endif
  assign slide_index = 0
-%}
<section class="hero" data-hero-section data-image-time="{{ section.settings.slide_seconds | times: 1000 }}">
  <div class="hero-media">
    {%- if has_video -%}
      {%- comment -%} Videos sit in <template>s so only the one for this screen size is downloaded, and none on data saver or reduced motion. {%- endcomment -%}
      {%- if section.settings.video != blank -%}
        <template data-hero-video="desktop">{{ section.settings.video | video_tag: autoplay: true, muted: true, loop: false, controls: false, playsinline: true, preload: 'auto', class: 'hero-video', image_size: '1600x' }}</template>
      {%- endif -%}
      {%- if section.settings.video_mobile != blank -%}
        <template data-hero-video="mobile">{{ section.settings.video_mobile | video_tag: autoplay: true, muted: true, loop: false, controls: false, playsinline: true, preload: 'auto', class: 'hero-video', image_size: '900x' }}</template>
      {%- endif -%}
    {%- endif -%}
    <div class="hero-images">
      {%- for block in section.blocks -%}
        {%- if block.type == 'slide' and block.settings.image != blank -%}
          <div class="hero-image{% if slide_index == 0 %} is-active{% endif %}" data-hero-image {{ block.shopify_attributes }}>
            {%- if slide_index == 0 -%}
              {{ block.settings.image | image_url: width: 2200 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 2200', sizes: '100vw', alt: block.settings.image.alt }}
            {%- else -%}
              {{ block.settings.image | image_url: width: 2200 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2200', sizes: '100vw', alt: block.settings.image.alt }}
            {%- endif -%}
          </div>
          {%- assign slide_index = slide_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <div class="hero-shade"></div>
  <div class="hero-content container">
    {%- if section.settings.eyebrow != blank -%}<p class="hero-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.copy != blank -%}<p>{{ section.settings.copy | escape }}</p>{%- endif -%}
    {%- if section.settings.button != blank -%}
      <a class="button button-cream" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button | escape }}</a>
    {%- endif -%}
  </div>
  <div class="hero-dots" data-hero-dots role="group" aria-label="Slides"></div>
</section>

{% schema %}
{
  "name": "Hero: video + slides",
  "settings": [
    { "type": "video", "id": "video", "label": "Video for desktop", "info": "Plays once, then the images rotate. Keep it short (10–20 seconds)." },
    { "type": "video", "id": "video_mobile", "label": "Video for phones", "info": "Optional. A lighter, portrait version for phones. If empty, phones skip the video and show the images, which saves mobile data." },
    { "type": "text", "id": "eyebrow", "label": "Small text above heading", "info": "Leave blank to hide." },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Warm little layers for winter." },
    { "type": "text", "id": "copy", "label": "Description", "default": "Soft jackets, knits and rompers for newborns to 3 years." },
    { "type": "text", "id": "button", "label": "Button label", "default": "Shop winter arrivals" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "range", "id": "slide_seconds", "label": "Seconds per image", "min": 3, "max": 10, "step": 1, "default": 5 }
  ],
  "blocks": [
    { "type": "slide", "name": "Image", "settings": [ { "type": "image_picker", "id": "image", "label": "Image" } ] }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Hero: video + slides" }]
}
{% endschema %}
