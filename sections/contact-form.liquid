<section class="tb-contact container">
  <div class="tb-contact-inner">
    {%- assign wa_greeting = 'general.contact.whatsapp_greeting' | t -%}
    {%- capture wa_url -%}{% render 'whatsapp-url', message: wa_greeting %}{%- endcapture -%}
    {%- liquid
      assign has_channels = false
      if wa_url != blank or settings.contact_email != blank or settings.instagram_url != blank
        assign has_channels = true
      endif
    -%}
    {%- if section.settings.show_channels and has_channels -%}
      <div class="tb-contact-cards">
        {%- if wa_url != blank -%}
          <a class="tb-contact-card is-primary" href="{{ wa_url }}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp' %}<strong>{{ 'general.contact.whatsapp' | t }}</strong><span>{{ section.settings.whatsapp_note | escape }}</span></a>
        {%- endif -%}
        {%- if settings.contact_email != blank -%}
          <a class="tb-contact-card" href="mailto:{{ settings.contact_email }}">{% render 'icon', name: 'email' %}<strong>{{ 'general.contact.email' | t }}</strong><span>{{ settings.contact_email | escape }}</span></a>
        {%- endif -%}
        {%- if settings.instagram_url != blank -%}
          <a class="tb-contact-card" href="{{ settings.instagram_url }}" target="_blank" rel="noopener">{% render 'icon', name: 'instagram' %}<strong>{{ 'general.contact.instagram' | t }}</strong><span>{{ section.settings.instagram_note | escape }}</span></a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- form 'contact', id: 'ContactForm', class: 'tb-contact-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="tb-form-success" role="status" tabindex="-1" autofocus>{{ 'contact_form.success' | t }}</p>
      {%- endif -%}
      {%- if form.errors -%}<div class="tb-form-errors" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="tb-field-row">
        <div class="tb-field"><label for="ContactForm-name">{{ 'contact_form.name' | t }}</label><input id="ContactForm-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
        <div class="tb-field"><label for="ContactForm-email">{{ 'contact_form.email' | t }} *</label><input id="ContactForm-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
      </div>
      <div class="tb-field-row">
        <div class="tb-field"><label for="ContactForm-phone">{{ 'contact_form.phone' | t }}</label><input id="ContactForm-phone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}"></div>
        <div class="tb-field"><label for="ContactForm-order">{{ 'contact_form.order' | t }}</label><input id="ContactForm-order" type="text" name="contact[order_number]"></div>
      </div>
      <div class="tb-field"><label for="ContactForm-body">{{ 'contact_form.message' | t }} *</label><textarea id="ContactForm-body" name="contact[body]" rows="6" required>{{ form.body }}</textarea></div>
      <button type="submit" class="button tb-contact-submit">{{ 'contact_form.send' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "checkbox", "id": "show_channels", "label": "Show WhatsApp, email and Instagram cards", "default": true },
    { "type": "text", "id": "whatsapp_note", "label": "WhatsApp card text", "default": "Sizes, real photos and order help" },
    { "type": "text", "id": "instagram_note", "label": "Instagram card text", "default": "Send us a message" },
    { "type": "text", "id": "heading", "label": "Form heading", "default": "Or send us a message" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
