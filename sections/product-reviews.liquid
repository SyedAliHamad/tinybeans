{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign has_rating = false
  if rating and rating_count > 0
    assign has_rating = true
  endif
  assign block_count = section.blocks.size
  assign show_section = false
  if has_rating or block_count > 0 or request.design_mode
    assign show_section = true
  endif
-%}
{%- if show_section -%}
  <section class="tb-reviews container" id="reviews" aria-labelledby="ReviewsTitle-{{ section.id }}">
    <h2 id="ReviewsTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
    <div class="tb-reviews-layout{% unless has_rating %} no-summary{% endunless %}">
      {%- if has_rating -%}
        {%- assign rating_text = rating.rating | round: 1 -%}
        <div class="tb-score">
          <div class="tb-score-number">{{ rating_text }}</div>
          {% render 'rating-stars', rating: rating.rating, max: rating.scale_max %}
          <p>{{ 'reviews.based_on' | t: count: rating_count }}</p>
        </div>
      {%- endif -%}
      <div class="tb-review-list">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="tb-review-app">{% render block %}</div>
            {%- when 'review' -%}
              {%- if block.settings.quote != blank -%}
                <article class="tb-review" {{ block.shopify_attributes }}>
                  {% render 'rating-stars', rating: block.settings.rating, max: 5 %}
                  <blockquote>“{{ block.settings.quote | escape }}”</blockquote>
                  <p class="tb-review-by">
                    {{- block.settings.name | escape -}}
                    {%- if block.settings.city != blank -%}, {{ block.settings.city | escape }}{%- endif -%}
                    {%- if block.settings.detail != blank -%}<span> · {{ block.settings.detail | escape }}</span>{%- endif -%}
                  </p>
                </article>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
        {%- if request.design_mode and block_count == 0 and has_rating == false -%}
          <p class="tb-editor-hint">{{ 'reviews.editor_hint' | t }}</p>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product reviews",
  "tag": "div",
  "class": "tb-reviews-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What parents say" },
    { "type": "paragraph", "content": "The star rating and score come from your reviews app (most apps, such as Judge.me, fill these in automatically). Add the app’s review block here to show its reviews. The section is hidden on products with no rating and no blocks." }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "review",
      "name": "Shop review",
      "settings": [
        { "type": "paragraph", "content": "Shown on every product. Use for real reviews about the shop in general. For reviews of a specific product, use a reviews app." },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Review" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "city", "label": "City" },
        { "type": "text", "id": "detail", "label": "Extra detail", "info": "e.g. Bought 3–6M" }
      ]
    }
  ],
  "presets": [{ "name": "Product reviews" }]
}
{% endschema %}
