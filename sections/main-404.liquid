<section class="tb-404 container">
  <h1>{{ 'not_found.title' | t }}</h1>
  <p>{{ 'not_found.text' | t }}</p>
  <div class="tb-404-actions">
    <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'not_found.button' | t }}</a>
    <a class="tb-text-button" href="{{ routes.root_url }}">{{ 'not_found.home' | t }}</a>
  </div>
  {%- if section.settings.collection != blank and section.settings.collection.products_count > 0 -%}
    <div class="product-grid tb-404-products">
      {%- for product in section.settings.collection.products limit: 4 -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Page not found",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Show products from", "info": "Optional. Shows 4 products to help people keep shopping." }
  ]
}
{% endschema %}
