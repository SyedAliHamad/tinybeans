{%- assign featured_collection = section.settings.collection -%}
<section class="section container winter-products">
  <div class="winter-products-intro">
    <div>
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.description != blank -%}<p>{{ section.settings.description | escape }}</p>{%- endif -%}
    </div>
    {%- if section.settings.link_text != blank -%}
      <a href="{{ featured_collection.url | default: routes.all_products_collection_url }}" class="text-link">{{ section.settings.link_text | escape }}</a>
    {%- endif -%}
  </div>
  <div class="product-grid">
    {%- if featured_collection != blank and featured_collection.products_count > 0 -%}
      {%- for product in featured_collection.products limit: section.settings.limit -%}
        {% render 'product-card', product: product, collection: featured_collection %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <article class="tb-product-card">
          <div class="tb-product-image"><span class="tb-card-placeholder">{{ 'products.photo_placeholder' | t }}</span></div>
          <p class="tb-product-name">{{ 'products.photo_placeholder' | t }}</p>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New for winter" },
    { "type": "text", "id": "description", "label": "Description", "default": "Warm, soft pieces for colder days." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 12, "step": 4, "default": 4 },
    { "type": "text", "id": "link_text", "label": "Link label", "default": "View all" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
